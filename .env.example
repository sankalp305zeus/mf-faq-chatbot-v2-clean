# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# Real environment variables always take precedence over .env values.

# ── LLM (required for Phase 4+ generation path) ──────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector store ──────────────────────────────────────────────────────────────
# Relative paths are resolved from the repo root.
CHROMA_PATH=data/index
COLLECTION_NAME=mf_faq

# ── Ingestion ─────────────────────────────────────────────────────────────────
FETCH_TIMEOUT=20
FETCH_RETRIES=1
FETCH_USER_AGENT=Mozilla/5.0 (compatible; mf-faq-bot/0.1; +https://example.com)

# ── API / server (Phase 5) ────────────────────────────────────────────────────
RATE_LIMIT=30/minute

# ── Development helpers ───────────────────────────────────────────────────────
# Set MOCK_LLM=1 to skip real Groq calls and return a deterministic stub response.
MOCK_LLM=0
# Standard Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
