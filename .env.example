# Copy to .env and fill real values. NEVER commit .env.

# --- LLM (Phase 4) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (Phase 2) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store (Phase 2) ---
CHROMA_DIR=data/index

# --- Ingestion (Phase 1) ---
FETCH_TIMEOUT=20
FETCH_RETRIES=1
FETCH_USER_AGENT=Mozilla/5.0 (compatible; mf-faq-bot/0.1; +https://example.com)

# --- API (Phase 5) ---
RATE_LIMIT=30/minute
MOCK_LLM=0
